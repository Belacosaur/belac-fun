/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Content-Security-Policy: default-src 'self'; frame-src https://www.youtube.com https://www.youtube-nocookie.com https://www.tiktok.com https://x.com; connect-src 'self'
/admin/*
  X-Content-Type-Options: nosniff
  Cache-Control: private, no-store
